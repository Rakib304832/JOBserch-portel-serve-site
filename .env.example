# .env.example
# ---------------------------------------------------------------------------
# WHAT THIS FILE IS USED FOR:
# Safe, committed template of the secret ".env" file. The real ".env" is
# listed in .gitignore and stays only on the developer's machine.
#
# HOW TO USE: copy this file to ".env" (cp .env.example .env) and replace the
# placeholder values with your own. Every key below is validated by
# src/config/env.js - the server refuses to start if one is missing/invalid.
# ---------------------------------------------------------------------------

# Port the HTTP server listens on (defaults to 5000 if omitted)
PORT=5000

# MongoDB connection string. Local dev example:
#   mongodb://127.0.0.1:27017
# Atlas example:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGO_URI="mongodb://127.0.0.1:27017"

# Database name inside MongoDB (collections: user, jobs, companies, ...)
DB_NAME="hireloopdb"

# Secret used to sign JWT login tokens. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-random-32-plus-character-secret-string"

# Google OAuth 2.0 Client ID (from console.cloud.google.com) - used to verify
# the ID token that the client sends to POST /api/auth/google
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# URL of the Next.js client. CORS allows ONLY this origin to call the API,
# and cookies are scoped to it.
CLIENT_URL="http://localhost:3000"

# Environment: "development" | "production" | "test"
NODE_ENV="development"
